# Copia este archivo como `.env` y reemplaza los valores.
# El archivo .env NO debe subirse al repositorio.

# "AMQP URL" de tu instancia CloudAMQP (plan gratuito Little Lemur)
CLOUDAMQP_URL=amqps://usuario:contrasena@host/vhost

# URL del propio sitio. En desarrollo: http://localhost:8888
# En produccion: https://<tu-sitio>.netlify.app
APP_URL=http://localhost:8888

# Transporte hacia el broker: "amqp" (amqplib, puerto 5671) o "http"
# (API de gestion por HTTPS 443; util si tu red bloquea los puertos AMQP)
RABBIT_TRANSPORT=amqp
